# Python 运行产物
__pycache__/
*.pyc
*.pyo

# 训练产物（大文件，不走 git）
# out_dir/ 整体忽略，但放行训练可视化图（每张 ~0.2MB，属实验记录，值得留痕）
out_dir/*
!out_dir/**/
out_dir/**/net_checkpoints/
*.tar
*.pth
*.pth.tar
*.ckpt
*.onnx

# 数据集（UHDM 数据集走网盘/Google Drive，不放仓库）
uhdm_data/
*.tar.gz

# 大文件搬运目录（走移动硬盘，不进 git；详见 _hd_transfer/README.md）
_hd_transfer/

# 合成冒烟数据（可由 pdnet_smoke/make_synth_data.py 以固定种子重新生成）
pdnet_smoke/synth_data/

# 环境与 IDE
.env
.venv/
.venv*/
.idea/
.vscode/
