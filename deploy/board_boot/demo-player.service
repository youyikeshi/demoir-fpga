[Unit]
Description=Demo player (bitstream + listener + N-pair loop)
After=network.target
Wants=network.target

[Service]
Type=simple
User=root
Group=root
Environment=XILINX_XRT=/usr
Environment=PAIRS=/home/xilinx/demo/pairs100
Environment=LOOPS=0
# 演示默认 = 6.2 s/张（= v57 @75 MHz 真实算法吞吐；用户 2026-11-04 决定）
# 首帧也是 6.2；要演示"首轮含一次性探针"就写 DELAY=13.5
# 想要 1 fps（仅对焦/试片）就写 DELAY=1.0 / PERIOD=1.0
Environment=DELAY=6.2
Environment=PERIOD=6.2
ExecStart=/usr/local/sbin/demo-boot.sh
Restart=no
StandardOutput=journal
StandardError=journal
TimeoutStopSec=15

[Install]
WantedBy=multi-user.target
