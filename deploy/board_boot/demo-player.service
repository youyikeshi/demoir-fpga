[Unit]
Description=Demo player (bitstream + listener + N-pair loop)
After=network.target
Wants=network.target

[Service]
Type=simple
User=root
Group=root
Environment=XILINX_XRT=/usr
Environment=PAIRS=/home/xilinx/demo/pairs100
Environment=LOOPS=0
# 按 v57 @75 MHz 实测节奏：首轮 13.5 s（含一次性探针），后续 6.2 s/张
# 想要 1 fps 的观感就换成 DELAY=1.0 / PERIOD=1.0
Environment=DELAY=13.5
Environment=PERIOD=6.2
ExecStart=/usr/local/sbin/demo-boot.sh
Restart=no
StandardOutput=journal
StandardError=journal
TimeoutStopSec=15

[Install]
WantedBy=multi-user.target
