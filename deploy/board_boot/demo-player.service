[Unit]
Description=Demo player (bitstream + listener + N-pair loop)
After=network.target
Wants=network.target

[Service]
Type=simple
User=root
Group=root
Environment=XILINX_XRT=/usr
Environment=PAIRS=/home/xilinx/demo/pairs100
Environment=LOOPS=0
# 演示默认 = 1 fps（用户规格：收到 START 后一秒一帧，播的是预生成图对）
# 想看"真实算法多快"才换成 DELAY=13.5 / PERIOD=6.2（--cadence real 那一档）
Environment=DELAY=1.0
Environment=PERIOD=1.0
ExecStart=/usr/local/sbin/demo-boot.sh
Restart=no
StandardOutput=journal
StandardError=journal
TimeoutStopSec=15

[Install]
WantedBy=multi-user.target
