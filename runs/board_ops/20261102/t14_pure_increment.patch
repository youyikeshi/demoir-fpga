+        lim = base * float(PERF_GATE["ratio"])
+        if float(got) > lim:
+            out.append(dict(bucket=key, got_s=float(got), base_s=base,
+                            limit_s=lim, ratio=float(PERF_GATE["ratio"]),
+                            hw=(int(hw) if hw is not None else PERF_GATE["hw"])))
+    return out
