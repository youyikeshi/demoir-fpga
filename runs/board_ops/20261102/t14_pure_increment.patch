+             else "疑似 numpy 跨步回落（c8deq 未装上）")
+    return ("[PERF] ⚠⚠ %s = %.3f s > 门槛 %.3f s（历史 %.3f s × %.2f）"
+            "⇒ %s ⇒ run_valid=False，本跑点不许进基线表"
+            % (what, a["got_s"], a["limit_s"], a["base_s"], a["ratio"], guess))
+
