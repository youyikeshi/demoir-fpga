// ============================================================================
//  tb_oob_wrap.v ——「整条 AXI 包装层 + 8-lane 卷积核」的输出写越界探针
//
//  与 tb_oob_conv8.v 的分工：
//    · tb_oob_conv8.v   验证**单元**写口的地址空间（结论：正好等于 out_bytes）
//    · 本文件          验证 **AXI 包装层**有没有在 out_bytes 之后多写一个 beat
//                      （= 8 字节；AW/W 通道由包装层产生，DDR 布局由从机模型解释）
//
//  三个监视点（这才是"板上金丝雀"的仿真等价物）：
//    ① WS_DATA：每个 W 拍按 WSTRB 逐字节落 mem[]，同时记录
//         maxend  = 实际写到的最大字节地址
//         beat    = W 拍数、aw = AW 笔数
//    ② 金丝雀：输出区 [B_OUT+OUT_BYTES, B_OUT+OUT_BYTES+CANARY) 预填 0xA5，
//         跑完统计被改写的字节数（= 板上 BinGuard.check_canary 的仿真版）
//    ③ 地址区间：任何落在 [B_OUT, B_OUT+OUT_BYTES) 之外的写都单独计数
//         （超界写 / 低于基址写）
//
//  plusarg：+CIN +COUT +K +S +D +PAD +H +W +SHIFT +MAXCYC +FAST
//    +FAST=1（默认）读侧 1 拍延迟、无反压 ⇒ 只测功能；+FAST=0 用 1..20 拍延迟+反压
// ============================================================================
`timescale 1ns/1ps

module tb_oob_wrap;

    localparam int AXIW = 4;
    localparam int MAXM = 1 << 22;              // 4 MiB 内存模型
    logic [7:0] mem [0:MAXM-1];

    // ---- 各基址（都 8 字节对齐、非 0）----
    localparam int B_IN    = 32'h0001_0000;
    localparam int B_WGT   = 32'h0005_0000;
    localparam int B_BIAS  = 32'h0008_0000;
    localparam int B_ZETA  = 32'h0009_0000;
    localparam int B_GAMMA = 32'h000A_0000;
    localparam int B_SLOPE = 32'h000B_0000;
    localparam int B_ALPHA = 32'h000C_0000;
    localparam int B_OUT   = 32'h0020_0000;

    localparam int CANARY  = 4096;
    localparam [7:0] CAN   = 8'hA5;

    // ---- 寄存器偏置（与 tb_bin_unit_axi_wrap.v / bin_unit_axi_wrap.v 一致）----
    localparam [15:0] R_AP_CTRL = 16'h00, R_AP_RET = 16'h10;
    localparam [15:0] R_C  = 16'h18, R_H = 16'h20, R_W = 16'h28;
    localparam [15:0] R_K  = 16'h40, R_S = 16'h48, R_D = 16'h50, R_PAD = 16'h58;
    localparam [15:0] R_SHIFT = 16'h60, R_ASH = 16'h68, R_SSH = 16'h6C, R_COUT = 16'h70;
    localparam [15:0] B_IN_ = 16'h80, B_WGT_ = 16'hA0;
    localparam [15:0] B_BIAS_ = 16'hB0, B_ZETA_ = 16'hB8, B_GAMMA_ = 16'hBC;
    localparam [15:0] B_SLOPE_ = 16'hC0, B_OUT_ = 16'hD0, B_ALPHA_ = 16'hD8;
    localparam [15:0] R_EGRP   = 16'h204, R_EDESC = 16'h208, R_EOUT = 16'h210;
    localparam [15:0] R_RUN_UNIT = 16'h200;
    localparam [15:0] R_DBG_WR = 16'hE8;

    // ---------------- 时钟 / 复位 ----------------
    logic clk = 1'b0;
    logic rst_n = 1'b0;
    always #5 clk = ~clk;

    // ---------------- DUT ----------------
    logic        s_awvalid, s_awready;
    logic [31:0] s_awaddr;
    logic        s_wvalid, s_wready;
    logic [31:0] s_wdata;
    logic [3:0]  s_wstrb;
    logic        s_bvalid, s_bready;
    logic [1:0]  s_bresp;
    logic        s_arvalid, s_arready;
    logic [31:0] s_araddr;
    logic        s_rvalid, s_rready;
    logic [31:0] s_rdata;
    logic [1:0]  s_rresp;

    logic        m_arvalid, m_arready;
    logic [31:0] m_araddr;
    logic [3:0]  m_arlen;
    logic [AXIW-1:0] m_arid;
    logic        m_rvalid, m_rready;
    logic [63:0] m_rdata;
    logic        m_rlast;
    logic [AXIW-1:0] m_rid;
    logic        m_awvalid, m_awready;
    logic [31:0] m_awaddr;
    logic [3:0]  m_awlen;
    logic [AXIW-1:0] m_wid;
    logic        m_wvalid, m_wready;
    logic [63:0] m_wdata;
    logic [7:0]  m_wstrb;
    logic        m_wlast;
    logic        m_bvalid, m_bready;
    logic [1:0]  m_bresp;

    // ---- AXI4-Lite 主机的驱动寄存器（必须在使用前声明）----
    logic [31:0] l_awaddr, l_wdata, l_araddr, l_rdata;
    logic [3:0]  l_wstrb;
    logic        l_awvalid, l_wvalid, l_bready, l_arvalid, l_rready;

    bin_unit_axi_wrap #(.AXI_ID_W(AXIW)) dut (
        .s_axi_aclk(clk), .s_axi_aresetn(rst_n),
        .s_axi_awvalid(l_awvalid), .s_axi_awready(s_awready),
        .s_axi_awaddr(l_awaddr),
        .s_axi_wvalid(l_wvalid), .s_axi_wready(s_wready),
        .s_axi_wdata(l_wdata), .s_axi_wstrb(l_wstrb),
        .s_axi_bvalid(s_bvalid), .s_axi_bready(l_bready), .s_axi_bresp(s_bresp),
        .s_axi_arvalid(l_arvalid), .s_axi_arready(s_arready),
        .s_axi_araddr(l_araddr),
        .s_axi_rvalid(s_rvalid), .s_axi_rready(l_rready),
        .s_axi_rdata(s_rdata), .s_axi_rresp(s_rresp),
        .m_axi_arvalid(m_arvalid), .m_axi_arready(m_arready),
        .m_axi_araddr(m_araddr), .m_axi_arlen(m_arlen), .m_axi_arid(m_arid),
        .m_axi_rvalid(m_rvalid), .m_axi_rready(m_rready),
        .m_axi_rdata(m_rdata), .m_axi_rlast(m_rlast), .m_axi_rid(m_rid),
        .m_axi_awvalid(m_awvalid), .m_axi_awready(m_awready),
        .m_axi_awaddr(m_awaddr), .m_axi_awlen(m_awlen), .m_axi_wid(m_wid),
        .m_axi_wvalid(m_wvalid), .m_axi_wready(m_wready),
        .m_axi_wdata(m_wdata), .m_axi_wstrb(m_wstrb), .m_axi_wlast(m_wlast),
        .m_axi_bvalid(m_bvalid), .m_axi_bready(m_bready)
    );

    // =========================================================================
    // AXI4-Lite 主机
    // =========================================================================

    task automatic lite_wr(input [31:0] addr, input [31:0] data);
        begin
            @(posedge clk);
            l_awaddr <= addr; l_awvalid <= 1'b1;
            l_wdata  <= data; l_wstrb <= 4'hF; l_wvalid <= 1'b1;
            l_bready <= 1'b1;
            fork
                begin
                    @(posedge clk);
                    while (!s_awready) @(posedge clk);
                    l_awvalid <= 1'b0;
                end
                begin
                    @(posedge clk);
                    while (!s_wready) @(posedge clk);
                    l_wvalid <= 1'b0;
                end
            join
            while (!s_bvalid) @(posedge clk);
            @(posedge clk);
            l_bready <= 1'b0;
        end
    endtask

    task automatic lite_rd(input [31:0] addr, output [31:0] data);
        begin
            @(posedge clk);
            l_araddr <= addr; l_arvalid <= 1'b1; l_rready <= 1'b1;
            @(posedge clk);
            while (!s_arready) @(posedge clk);
            l_arvalid <= 1'b0;
            while (!s_rvalid) @(posedge clk);
            data = s_rdata;
            @(posedge clk);
            l_rready <= 1'b0;
        end
    endtask

    task automatic w_cfg(input [15:0] off, input [31:0] d);
        lite_wr({15'd0, 1'b1, off}, d);          // A[16]=1 = 配置页
    endtask
    task automatic r_cfg(input [15:0] off, output [31:0] d);
        lite_rd({15'd0, 1'b1, off}, d);
    endtask

    // =========================================================================
    // AXI3 读从机模型（8 项请求队列 + 每拍回 1 个 8 字节字）
    //   ★ 第一版写成"单缓冲 + arready 用寄存器"，结果 AR 会在同一拍被吞掉
    //     （rq_v 还是 0 ⇒ arready 仍为 1）⇒ 丢 AR ⇒ 引擎 rd_hit 永不成立 ⇒ 卡死。
    //     这里改成组合 arready + 8 项队列，杜绝该类 TB bug。
    // =========================================================================
    int          rslow = 0;
    int          rhold = 0;
    logic [31:0] lfsr_p = 32'hBEEF_1234;
    always_ff @(posedge clk) lfsr_p <= lfsr_p * 32'd1664525 + 32'd1013904223;
    localparam int RQN = 8;
    logic [31:0] q_addr [0:RQN-1];
    logic [3:0]  q_len  [0:RQN-1];
    logic [3:0]  q_cnt4 [0:RQN-1];
    logic [AXIW-1:0] q_id [0:RQN-1];
    int          q_wp = 0, q_rp = 0, q_n = 0;

    wire [31:0] cur_addr = q_addr[q_rp] + 32'(q_cnt4[q_rp]) * 32'd8;

    // 读侧反压（RSLOW=1 时模拟 DDR 行填充延迟）
    assign m_arready = (q_n < RQN);
    assign m_rvalid  = (q_n != 0) && (rhold == 0);
    assign m_rlast   = (q_n != 0) && (q_cnt4[q_rp] == q_len[q_rp]);
    assign m_rid     = q_id[q_rp];   // 必须回送 ARID（= 填充槽号）
    assign m_rdata   = (q_n != 0) ?
                       {mem[cur_addr+7], mem[cur_addr+6], mem[cur_addr+5], mem[cur_addr+4],
                        mem[cur_addr+3], mem[cur_addr+2], mem[cur_addr+1], mem[cur_addr+0]}
                       : 64'd0;

    always_ff @(posedge clk) begin
        if (!rst_n) begin
            q_wp <= 0; q_rp <= 0; q_n <= 0;
        end else begin
            if (m_arvalid && m_arready) begin
                q_addr[q_wp] <= m_araddr;
                q_len [q_wp] <= m_arlen;
                q_cnt4[q_wp] <= 4'd0;
                q_id  [q_wp] <= m_arid;
                q_wp <= (q_wp + 1) % RQN;
                q_n  <= q_n + 1;
            end
            if (m_rvalid && m_rready) begin
                if (m_rlast) begin
                    q_rp <= (q_rp + 1) % RQN;
                    q_n  <= q_n - 1;
                end else begin
                    q_cnt4[q_rp] <= q_cnt4[q_rp] + 4'd1;
                end
                rhold <= rslow ? (3 + (lfsr_p[6:2])) : 0;
            end else if (rhold != 0) begin
                rhold <= rhold - 1;
            end
        end
    end

    // =========================================================================
    // AXI3 写从机模型 + 越界监视（+WSLOW=1 打开反压 ⇒ 让 beat FIFO 进压力区、
    //   u_ce 被冻住，复现板上"DDR 慢"的工作点）
    // =========================================================================
    typedef enum logic [1:0] {WS_IDLE, WS_DATA, WS_RESP} ws_t;
    ws_t         wsl = WS_IDLE;
    logic [31:0] ws_addr;
    logic [3:0]  ws_len, ws_cnt = 4'd0;
    int          wb_dly = 0;
    int          wslow = 0;

    // ---- 监视量（每个用例清零）----
    longint wr_maxend;      // 实际写到的最大字节地址（含）
    longint wr_nbeat;       // W 拍数
    longint wr_nbyte;       // 置位字节数
    longint wr_naw;         // AW 笔数
    longint wr_over;        // 落在 [B_OUT, B_OUT+OUT_BYTES) 之外的字节数
    longint wr_below;       // 低于 B_OUT 的字节数
    longint out_bytes;      // 本层应写字节（PS 公式）
    longint canary_bad;     // 金丝雀被写坏字节数
    longint canary_lo;      // 金丝雀里第一个被写坏的偏移
    longint canary_hi;
    longint ba, co;         // 监视用临时量（模块级：always 块里不能声明 automatic）

    // 反压门：WSLOW=1 时大约每 8 拍放行 7 拍（AW/W 各自随机）
    wire aw_gate = (!wslow) || (lfsr_p[11:9] != 3'd0);
    wire w_gate  = (!wslow) || (lfsr_p[17:15] != 3'd0);

    assign m_awready = (wsl == WS_IDLE) && aw_gate;
    assign m_wready  = (wsl == WS_DATA) && w_gate;

    task automatic mon_reset(input longint ob);
        out_bytes  = ob;
        wr_maxend  = -1;
        wr_nbeat   = 0;
        wr_nbyte   = 0;
        wr_naw     = 0;
        wr_over    = 0;
        wr_below   = 0;
        canary_bad = 0;
        canary_lo  = -1;
        canary_hi  = -1;
        for (int i = 0; i < CANARY; i++) mem[B_OUT + ob + i] = CAN;
    endtask

    always_ff @(posedge clk) begin
        if (!rst_n) begin
            wsl <= WS_IDLE; ws_cnt <= 4'd0; ws_len <= 4'd0; ws_addr <= 32'd0;
            m_bvalid <= 1'b0; m_bresp <= 2'd0;
        end else begin
            case (wsl)
            WS_IDLE: begin
                if (m_awvalid && m_awready) begin
                    ws_addr <= m_awaddr;
                    ws_len  <= m_awlen;
                    ws_cnt  <= 4'd0;
                    wsl     <= WS_DATA;
                    wr_naw  = wr_naw + 1;
                    if (longint'(m_awaddr) < longint'(B_OUT))
                        $display("[OOB] !! AW 低于 B_OUT addr=%08h", m_awaddr);
                end
            end
            WS_DATA: begin
                if (m_wvalid && m_wready) begin
                    for (int bi = 0; bi < 8; bi++) begin
                        if (m_wstrb[bi]) begin
                            ba = longint'(ws_addr) + longint'(ws_cnt)*8 + bi;
                            mem[ba] = m_wdata[bi*8 +: 8];
                            wr_nbyte = wr_nbyte + 1;
                            if (ba > wr_maxend) wr_maxend = ba;
                            if (ba >= longint'(B_OUT) + out_bytes) begin
                                wr_over = wr_over + 1;
                                co = ba - longint'(B_OUT) - out_bytes;
                                if (canary_lo < 0 || co < canary_lo) canary_lo = co;
                                if (co > canary_hi) canary_hi = co;
                            end
                            if (ba < longint'(B_OUT)) wr_below = wr_below + 1;
                        end
                    end
                    wr_nbeat = wr_nbeat + 1;
                    if (ws_cnt == ws_len) begin
                        wsl      <= WS_RESP;
                        wb_dly    = wslow ? (10 + (lfsr_p[5:0])) : 1;
                        m_bvalid <= 1'b0;
                    end else begin
                        ws_cnt <= ws_cnt + 4'd1;
                    end
                end
            end
            WS_RESP: begin
                if (wb_dly != 0) wb_dly <= wb_dly - 1;
                else            m_bvalid <= 1'b1;
                if (m_bvalid && m_bready) begin
                    m_bvalid <= 1'b0;
                    wsl <= WS_IDLE;
                end
            end
            default: wsl <= WS_IDLE;
            endcase
        end
    end

    // 金丝雀复核（跑完扫描，等价于 BinGuard.check_canary）
    task automatic canary_check;
        begin
            canary_bad = 0;
            for (int i = 0; i < CANARY; i++)
                if (mem[B_OUT + out_bytes + i] != CAN) canary_bad = canary_bad + 1;
            for (int i = 0; i < CANARY; i++)
                if (mem[B_OUT + out_bytes + i] != CAN) begin
                    if (canary_lo < 0) canary_lo = i;
                    canary_hi = i;
                end
        end
    endtask

    // =========================================================================
    // 主流程
    // =========================================================================
    int C, COUT, K, S, D, PAD, H, W, SHIFT;
    int HOUT, WOUT, CG;
    longint exp_bytes;
    int t_i, max_cyc;
    int cyc;
    logic [31:0] ret;
    int nfail = 0;
    int ncase = 0;

    int misunit = 0;
    longint stale_out = 0, stale_desc = 0;
    int stale_grp = 0;

    task automatic run_case(input int cin_, cout_, k_, s_, d_, pad_, h_, w_, sh_);
        longint ob;
        begin
            C = cin_; COUT = cout_; K = k_; S = s_; D = d_; PAD = pad_;
            H = h_; W = w_; SHIFT = sh_;
            HOUT = (H - 1)/S + 1;
            WOUT = (W - 1)/S + 1;
            CG   = (COUT + 7)/8;
            ob   = longint'(CG) * HOUT * WOUT * 8;
            exp_bytes = ob;
            ncase = ncase + 1;

            // 干净内存：输入/权重都填 0（地址行为与数据无关）
            for (int i = 0; i < (32'h0024_0000); i++) mem[i] = 8'h00;
            mon_reset(ob);

            cfg_apply();
            // ★ P1：模拟"run_unit 误启动" —— arm() 不写 0x200（见 arm_plan），
            //   而 E1E2/catpack 的辅助寄存器（0x204/0x208/0x210、0x30/0x38）
            //   在 arm() 里同样不清 ⇒ 这里把它们置成"上一次作业的残值"。
            if (misunit != 0) begin
                w_cfg(R_EGRP,   stale_grp[31:0]);
                w_cfg(R_EDESC,  stale_desc[31:0]);
                w_cfg(R_EOUT,   stale_out[31:0]);
                w_cfg(R_RUN_UNIT, misunit[31:0]);
            end
            @(posedge clk);
            w_cfg(R_AP_CTRL, 32'd1);                 // start
            cyc = 0;
            while ((cyc < max_cyc) && (dut.done_sticky !== 1'b1)) begin
                @(posedge clk);
                cyc = cyc + 1;
            end
            repeat (4) @(posedge clk);
            r_cfg(R_AP_RET, ret);
            canary_check();

            $display("OOBW case=%0d misunit=%0d stale_out=%0d stale_desc=%0d cin=%0d cout=%0d k=%0d s=%0d pad=%0d H=%0d W=%0d",
                     ncase, misunit, stale_out, stale_desc, cin_, cout_, k_, s_, d_, pad_, h_, w_);
            $display("OOBW1b Hout=%0d Wout=%0d cg=%0d exp(out_bytes)=%0d", HOUT, WOUT, CG, ob);
            $display("OOBW2 lastbyte=%0d over=%0d canary=%0d can_lo=%0d can_hi=%0d aw=%0d beats=%0d wbytes=%0d cyc=%0d ret=%08h tmo=%0d",
                     (wr_maxend < 0) ? -1 : wr_maxend,
                     wr_over, canary_bad, canary_lo, canary_hi,
                     wr_naw, wr_nbeat, wr_nbyte, cyc, ret,
                     (dut.done_sticky !== 1'b1));
            if (wr_over != 0 || canary_bad != 0) begin
                nfail = nfail + 1;
                $display("[OOB] ✗ 越界：over=%0d 字节（地址 %0d..%0d），金丝雀坏 %0d 字节",
                         wr_over, canary_lo, canary_hi, canary_bad);
            end
        end
    endtask

    task automatic cfg_apply();
        begin
            w_cfg(R_C,     C[31:0]);
            w_cfg(R_H,     H[31:0]);
            w_cfg(R_W,     W[31:0]);
            w_cfg(R_COUT,  COUT[31:0]);
            w_cfg(R_K,     K[31:0]);
            w_cfg(R_S,     S[31:0]);
            w_cfg(R_D,     D[31:0]);
            w_cfg(R_PAD,   PAD[31:0]);
            w_cfg(B_IN_,    B_IN);
            w_cfg(B_WGT_,   B_WGT);
            w_cfg(B_ALPHA_, B_ALPHA);
            w_cfg(B_BIAS_,  B_BIAS);
            w_cfg(B_ZETA_,  B_ZETA);
            w_cfg(B_GAMMA_, B_GAMMA);
            w_cfg(B_SLOPE_, B_SLOPE);
            w_cfg(R_SHIFT,  SHIFT[31:0]);
            w_cfg(R_ASH,    32'd9);
            w_cfg(R_SSH,    32'd8);
            w_cfg(B_OUT_,   B_OUT);
        end
    endtask

    int sweep, ns;
    initial begin
        l_awvalid = 1'b0; l_wvalid = 1'b0; l_bready = 1'b0;
        l_arvalid = 1'b0; l_rready = 1'b0;
        l_awaddr = 32'd0; l_wdata = 32'd0; l_wstrb = 4'hF; l_araddr = 32'd0;
        max_cyc = 5_000_000;
        void'($value$plusargs("MAXCYC=%d", max_cyc));
        if (!$value$plusargs("SWEEP=%d", sweep)) sweep = 1;
        C = 64; COUT = 32; K = 3; S = 1; D = 1; PAD = 1; H = 8; W = 8; SHIFT = 7;
        void'($value$plusargs("CIN=%d",   C));
        void'($value$plusargs("COUT=%d",  COUT));
        void'($value$plusargs("K=%d",     K));
        void'($value$plusargs("S=%d",     S));
        void'($value$plusargs("D=%d",     D));
        void'($value$plusargs("PAD=%d",   PAD));
        void'($value$plusargs("H=%d",     H));
        void'($value$plusargs("W=%d",     W));
        void'($value$plusargs("SHIFT=%d", SHIFT));
        void'($value$plusargs("WSLOW=%d", wslow));
        void'($value$plusargs("RSLOW=%d", rslow));
        $display("[TB] 反压 WSLOW=%0d RSLOW=%0d（1=DDR 慢模型）", wslow, rslow);

        rst_n = 1'b0;
        repeat (10) @(posedge clk);
        rst_n <= 1'b1;
        repeat (5) @(posedge clk);

        $display("[TB] tb_oob_wrap 起跑 sweep=%0d rst_n=%b awready=%b", sweep, rst_n, s_awready);
        fork
            begin : wd_blk
                longint wd = 0;
                forever begin
                    @(posedge clk);
                    wd = wd + 1;
                    if ((wd % 50000) == 0)
                        $display("  [WD cyc=%0d] awr=%b wr=%b bv=%b run_active=%b flush=%b pend=%b unit=%0d done_sticky=%b u_busy=%b u_wr_en=%b wst=%0d bf=%0d df=%0d axst=%0d",
                                 wd, s_awready, s_wready, s_bvalid, dut.run_active,
                                 dut.flush_busy, dut.start_pend, dut.run_unit,
                                 dut.done_sticky, dut.u_busy, dut.u_wr_en,
                                 dut.wst, dut.bf_cnt, dut.df_cnt, dut.axst);
                    if (wd > 3000000) begin
                        $display("=== WRAPRESULT TIMEOUT(看门狗 %0d 拍) ===", wd);
                        $finish;
                    end
                end
            end
        join_none
        if (sweep == 3) begin
            // ---- 反向 P1：arm 的是 conv 形状 A（16×16,cout=96 → 24576 B），
            //      然后只改 C/H/W 成"下一层 pack 作业的几何"（32×32）不碰 r_cout/r_out，
            //      也不碰 0x200（=0=conv）⇒ 等价于"pack 作业被 conv 抢跑"。
            //      预期：conv 用 r_cout=96 / r_out=B_OUT 跑 32×32 ⇒ 98304 B ≫ 24576 B
            misunit = 0;
            run_case(64, 96, 3, 1, 1, 1, 16, 16, 7);
            // 第二套：几何改成 32×32（k/s/pad 沿用），cout/out 基址仍是旧的
            begin
                longint ob2;
                HOUT = 32; WOUT = 32; CG = 12; ob2 = longint'(CG)*32*32*8;
                ncase = ncase + 1;
                for (int i = 0; i < (32'h0024_0000); i++) mem[i] = 8'h00;
                mon_reset(ob2);                      // 金丝雀放在"新几何"的尾部
                cfg_apply();
                w_cfg(R_C, 32'd64); w_cfg(R_H, 32'd32); w_cfg(R_W, 32'd32);
                @(posedge clk);
                w_cfg(R_AP_CTRL, 32'd1);
                cyc = 0;
                while ((cyc < max_cyc) && (dut.done_sticky !== 1'b1)) begin
                    @(posedge clk); cyc = cyc + 1;
                end
                repeat (4) @(posedge clk);
                r_cfg(R_AP_RET, ret);
                canary_check();
                $display("OOBW case=%0d MISGEOM=1 旧几何 16x16(24576B) 跑成 32x32(98304B)", ncase);
                $display("OOBW2 lastbyte=%0d over=%0d canary=%0d can_lo=%0d can_hi=%0d beats=%0d wbytes=%0d cyc=%0d ret=%08h tmo=%0d",
                         (wr_maxend < 0) ? -1 : wr_maxend, wr_over, canary_bad, canary_lo, canary_hi,
                         wr_nbeat, wr_nbyte, cyc, ret, (dut.done_sticky !== 1'b1));
            end
        end else if (sweep == 2) begin
            // ---- P1 组：conv 形状 + 误启动 ----
            //  STALE_OUT = B_IN（模拟 r_eout 残留指向"上一层的 IN 槽"）
            //  STALE_DESC = B_ZETA（模拟 r_edesc 残留指向已释放的描述符区）
            misunit = 0; run_case(64, 96, 3, 1, 1, 1, 16, 16, 7);   // 对照：正常 conv
            misunit = 4; stale_out = B_IN; stale_desc = B_ZETA; stale_grp = 0;
            run_case(64, 96, 3, 1, 1, 1, 16, 16, 7);               // run_unit=4（E1E2）
            misunit = 5; stale_out = B_IN; stale_desc = B_ZETA; stale_grp = 0;
            run_case(64, 96, 3, 1, 1, 1, 16, 16, 7);               // run_unit=5（catpack）
            misunit = 4; stale_out = B_OUT; stale_desc = B_ZETA; stale_grp = 0;
            run_case(64, 96, 3, 1, 1, 1, 16, 16, 7);               // eout 恰好指到 OUT 基址
            misunit = 4; stale_out = B_IN; stale_desc = B_ZETA; stale_grp = 0;
            run_case(64, 96, 3, 1, 1, 1, 8, 8, 7);                 // 小形状（看是否 8 字节级）
            misunit = 0; run_case(64, 96, 3, 1, 1, 1, 16, 16, 7);  // 误启动后回到正常（看残留）
        end else if (sweep == 1) begin
            run_case(64,  32, 3, 1, 1, 1,  8,  8, 7);
            run_case(64,  64, 3, 1, 1, 1,  8,  8, 7);
            run_case(64,  48, 1, 1, 1, 0,  8,  8, 7);
            run_case(64,  96, 3, 1, 1, 1,  8,  8, 7);
            run_case(32,  32, 3, 1, 1, 1,  5,  7, 7);
            run_case(96,  32, 3, 1, 1, 1,  7,  9, 7);
            run_case(128,192, 3, 1, 1, 1,  4,  5, 7);
            run_case(64,  32, 3, 2, 1, 1,  6,  7, 7);
            run_case(64,  64, 3, 1, 1, 1,  1, 16, 7);
            run_case(64,  64, 1, 1, 1, 0, 16, 16, 7);
            run_case(64,  64, 3, 1, 1, 1, 16, 16, 7);
            run_case(64,  64, 3, 1, 1, 1, 32, 32, 7);
        end else begin
            run_case(C, COUT, K, S, D, PAD, H, W, SHIFT);
        end
        $display("=== WRAPSUMMARY cases=%0d fail=%0d ===", ncase, nfail);
        if (nfail == 0) $display("=== WRAPRESULT PASS(无越界) ===");
        else            $display("=== WRAPRESULT FAIL(有越界) ===");
        $finish;
    end

endmodule
